package-as: LedgerLink

# The addon lives in LedgerLink/; ship only that folder (plus LICENSE, which the
# packager copies in). tools/check-package-layout.sh enforces this in CI.
move-folders:
  LedgerLink/LedgerLink: LedgerLink

ignore:
  - spec
  - tools
  - contract
  - node_modules
  - package.json
  - package-lock.json
  - AGENTS.md
  - CLAUDE.md
  - README.md
